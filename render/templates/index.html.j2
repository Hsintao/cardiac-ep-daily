{#
  日报页面模板（单页应用式）—— 对齐参考项目 daily-arXiv-ai-enhanced 的架构：
    - 页面只是一个壳，不含论文数据；
    - 日期列表在构建时写入（来自 data/ 目录扫描）；
    - 用户选日期后，前端 fetch 对应 JSONL 就地渲染，不跳转。

  为什么这样做：此前的「每天一个归档页」需要两套模板，风格容易漂移
  （实际就出过历史页与首页完全不同的 bug）。单页方案只剩一套渲染逻辑。

  所有论文文本一律经 JS 的 escapeHtml 转义后再插入 DOM —— 见 app 脚本。
#}<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="description" content="心脏电生理每日论文检索">
<title>心脏电生理日报</title>
<script>
/* 主题初始化：必须在样式生效前执行，避免深色用户看到白屏闪烁 */
(function () {
    try {
        var saved = localStorage.getItem('ep-digest-theme');
        if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
        }
    } catch (e) {}
})();
</script>
<style>
{{ style | safe }}
</style>
</head>
<body>

<header class="site-header">
    <div class="wrap">
        <h1>心脏电生理每日论文检索</h1>
        <p class="subtitle">Cardiac Electrophysiology Daily Digest · 按亚专业分组的文献速览</p>

        {# 统计与主题切换合并为一行，避免多占一条空白行 #}
        <div class="header-meta">
            <span class="chip">📄 论文总数 <strong id="chipTotal">—</strong></span>
            <span class="chip">🤖 含 AI 解读 <strong id="chipAI">—</strong></span>
            <span class="chip" id="chipNoAbsWrap" hidden>📝 无摘要 <strong id="chipNoAbs">—</strong></span>
            <button type="button" class="theme-toggle" id="themeToggle"
                    aria-label="切换深色/浅色模式" title="切换深色/浅色模式">🌗 主题</button>
        </div>

        <div class="date-bar">
            <label class="date-bar-label" for="dateToggle">日期</label>
            <div class="date-select" id="dateSelect">
                <button type="button" class="date-toggle" id="dateToggle"
                        aria-haspopup="listbox" aria-expanded="false" aria-controls="datePanel">
                    <span class="date-toggle-text" id="dateToggleText">{{ default_date }}</span>
                    <span class="date-toggle-caret" aria-hidden="true">▾</span>
                </button>
                <div class="date-panel" id="datePanel" role="listbox" hidden>
                    <div class="date-panel-head">
                        <button type="button" class="date-panel-latest" id="jumpLatest">跳到最新 →</button>
                    </div>
                    <div class="date-panel-body">
                        {% for group in date_groups %}
                        <div class="date-month">
                            <div class="date-month-label">{{ group.label }}</div>
                            <div class="date-month-days">
                                {% for day in group.days %}
                                <button type="button" class="date-cell{% if day == default_date %} current{% endif %}"
                                        data-day="{{ day }}" role="option"
                                        aria-selected="{{ 'true' if day == default_date else 'false' }}">{{ day[8:10] }}</button>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="filters" id="top">
    <div class="wrap">
        <div class="filter-row">
            <span class="filter-label">主题</span>
            <div class="filter-buttons" id="topicFilters"></div>
        </div>
        <div class="filter-row">
            <span class="filter-label">期刊</span>
            <div class="filter-buttons" id="journalFilters"></div>
        </div>
        <div class="filter-row">
            <span class="filter-label">检索</span>
            <input type="search" id="textSearch" class="search-box"
                   placeholder="输入关键词过滤标题 / 作者 / 摘要（本地匹配，不联网）" aria-label="关键词过滤">
        </div>
    </div>
</div>

<main>
    <div class="wrap" id="paperContainer">
        <div class="loading-state" id="loadingState">
            <div class="loading-spinner"></div>
            <p>正在加载 {{ default_date }} 的论文…</p>
        </div>
    </div>
</main>

<footer class="site-footer">
    <div class="wrap">
        <p>数据来源：PubMed / Europe PMC</p>
    </div>
</footer>

<script id="site-config" type="application/json">
{
  "defaultDate": {{ default_date | tojson }},
  "days": {{ days | tojson }},
  "language": {{ language | tojson }}
}
</script>

<script>
{{ app_script | safe }}
</script>
</body>
</html>
