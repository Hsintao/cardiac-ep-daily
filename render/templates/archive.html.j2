{#
  归档页模板：单日论文的紧凑列表视图。
  同样自包含、可离线双击打开；位于 archive/ 目录下，depth=1 用于回主页链接。
#}<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="description" content="心脏电生理日报归档{% if date %} · {{ date }}{% endif %}">
<title>归档{% if date %} · {{ date }}{% endif %} · 心脏电生理日报</title>
<script>
/* 主题初始化：必须在样式生效前执行，避免深色用户看到白屏闪烁。
   读取顺序：localStorage 手动选择 > 系统偏好。写入 <html data-theme>。 */
(function () {
    try {
        var saved = localStorage.getItem('ep-digest-theme');
        if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
        }
    } catch (e) { /* 隐私模式下 localStorage 可能抛错，忽略即可 */ }
})();

/* 主题切换：跟随系统 → 手动选择 → 再点回到跟随系统。
   三态循环，按钮 title 显示当前状态，localStorage 记忆手动选择。 */
(function () {
    var btn = document.getElementById("themeToggle");
    if (!btn) { return; }
    var root = document.documentElement;
    var mql = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;

    function current() {
        var manual = root.getAttribute("data-theme");
        if (manual === "dark" || manual === "light") { return manual; }
        return (mql && mql.matches) ? "dark" : "light";
    }
    function label() {
        var manual = root.getAttribute("data-theme");
        var suffix = manual ? "" : "（跟随系统）";
        btn.textContent = (current() === "dark" ? "☀️ 浅色" : "🌙 深色") + suffix;
        btn.title = "当前：" + (current() === "dark" ? "深色" : "浅色") + suffix + "，点击切换";
    }
    btn.addEventListener("click", function () {
        var next = current() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("ep-digest-theme", next); } catch (e) {}
        label();
    });
    if (mql && mql.addEventListener) {
        mql.addEventListener("change", function () {
            if (!root.getAttribute("data-theme")) { label(); }
        });
    }
    label();
})();
</script>
<style>
{{ style | safe }}
/* 归档页专属微调 */
.archive-list .a-authors {
    flex: 0 0 auto;
    font-size: 12px;
    color: var(--text-tertiary);
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
@media (max-width: 640px) { .archive-list .a-authors { display: none; } }
</style>
</head>
<body>

<header class="site-header">
    <div class="wrap">
        <h1>心脏电生理日报 · 归档</h1>
        <p class="subtitle">{% if date %}{{ date }} 全部论文清单{% else %}全部论文清单{% endif %}</p>
        <div class="header-meta">
            {% if date %}<span class="chip">📅 <strong>{{ date }}</strong></span>{% endif %}
            <span class="chip">🕒 生成时间 <strong>{{ generated_at }}</strong></span>
            <span class="chip">📄 论文总数 <strong>{{ total }}</strong></span>
            <span class="chip">🤖 含 AI 解读 <strong>{{ ai_count }}</strong></span>
        </div>
        <nav class="header-nav">
            <a href="../index.html">← 返回主页</a>
            <a href="#top">回到顶部</a>
        </nav>
    </div>
</header>

<main id="top">
    <div class="wrap">

    {% if total == 0 %}
        <div class="empty-state">
            <div class="icon">🗂️</div>
            <h2>该日期没有论文</h2>
            <p>归档数据为空，可能是检索当天确实没有命中的文献（周末、节假日较为常见）。</p>
            <p class="hint">数据文件：<code>data/{{ date }}_AI_enhanced_Chinese.jsonl</code></p>
        </div>
    {% else %}

        {% for group in groups %}
        <section class="topic-group">
            <h2 class="topic-heading">
                <span class="bar"></span>
                <span>{{ group.topic }}</span>
                <span class="topic-count">{{ group.count }} 篇</span>
            </h2>
            <ul class="archive-list">
                {% for paper in group.papers %}
                <li>
                    <span class="topic-pill" data-topic="{{ paper.topic }}">{{ paper.topic }}</span>
                    <span class="a-title">
                        {% if paper.abstract_url %}
                        <a href="{{ paper.abstract_url }}" target="_blank" rel="noopener noreferrer">{{ paper.title }}</a>
                        {% else %}
                        {{ paper.title }}
                        {% endif %}
                    </span>
                    <span class="a-authors">{{ paper.authors | join('、') }}</span>
                    <span class="a-journal">{{ paper.journal }}</span>
                    <span class="a-actions">
                        {% for link in paper.links %}
                        <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>{% if not loop.last %} · {% endif %}
                        {% endfor %}
                    </span>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endfor %}

    {% endif %}

    </div>
</main>

<footer class="site-footer">
    <div class="wrap">
        <p>心脏电生理每日论文检索 · 归档视图</p>
        <p>页面离线自包含，无外部依赖 · 生成于 {{ generated_at }}</p>
    </div>
</footer>

</body>
</html>
